# Build output.
#
# Build with CARGO_TARGET_DIR pointing outside the repository so the working tree never contains
# untracked files:
#   export CARGO_TARGET_DIR=../_build/mania-sr-pp-reimagined   # PowerShell: $env:CARGO_TARGET_DIR
target/
debug

# rustfmt backups, MSVC debug symbols
**/*.rs.bk
*.pdb

# Beatmap files are copyrighted and large; they are read from a local cache outside the repository.
**/*.osu
AGENTS.md
